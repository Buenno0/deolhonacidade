# Copie para .env.local. Os valores locais aparecem em `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usada pela rota de limpeza /api/cron/expire
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que o agendador envia em "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Endereço público do app (links e prévias do WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Captcha do login (Cloudflare Turnstile). Local: a chave de teste abaixo, que
# sempre passa. O segredo vai em supabase/.env (local) ou no painel do Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
# Alertas por área (Web Push). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Base do mapa "Padrão" (OpenFreeMap, grátis e sem chave). lib/map/style.ts
# repinta as camadas pelo id, então precisa ser o positron.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
# Satélite: o Esri World Imagery serve para testar. Em produção, use uma URL
# com chave (ArcGIS Location Platform ou MapTiler; ambos têm plano gratuito).
# NEXT_PUBLIC_SATELLITE_TILES=https://.../{z}/{y}/{x}

# --- AWS (opcional; sem isto tudo roda no Supabase e sem moderação) ---
# Os valores saem de `tofu output env_app` em infra/.
# STORAGE_PROVIDER=s3
# MODERATION_PROVIDER=rekognition
# AWS_REGION=us-east-1
# S3_BUCKET=
# NEXT_PUBLIC_MEDIA_BASE_URL=https://xxxx.cloudfront.net
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
