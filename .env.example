# Copie para .env.local. Os valores locais aparecem em `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usada pela rota de limpeza /api/cron/expire
SUPABASE_SERVICE_ROLE_KEY=
# Segredo que o agendador envia em "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Estilo do mapa (OpenFreeMap é gratuito e não precisa de chave)
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
