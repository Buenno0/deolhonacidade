{
  "name": "deolhonacidade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "node scripts/copy-maplibre-worker.mjs && node scripts/gerar-tokens.mjs",
    "predev": "npm run prepare",
    "dev": "next dev",
    "prebuild": "npm run prepare",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens": "node scripts/gerar-tokens.mjs",
